# BEAN Jetson environment template. Rendered on first install.
# Existing /etc/bean/bean.env is preserved on reruns.
BEAN_HOME=@BEAN_HOME@
BEAN_DATA_DIR=@BEAN_DATA_DIR@
BEAN_LOG_DIR=@BEAN_LOG_DIR@
BEAN_DB_PATH=@BEAN_DATA_DIR@/bean_memory.db
BEAN_INBOX_DIR=@BEAN_DATA_DIR@/inbox
BEAN_TICK_HZ=1.0
PYTHONUNBUFFERED=1

# Existing local language provider. Run llama.cpp separately with alias bean-local.
# No model download, paid API, or network inference is installed by this package.
BEAN_REASONING_ENABLED=1
BEAN_REASONING_PROVIDER=local_llamacpp
BEAN_LOCAL_LLM_URL=http://127.0.0.1:8080
BEAN_LOCAL_LLM_MODEL=bean-local

# Optional watcher. Both variables must be configured to enable.
# BEAN_WATCH_CONFIG=@BEAN_DATA_DIR@/watch/config.json
# BEAN_WATCH_REPORT_DIR=@BEAN_DATA_DIR@/watch/reports
