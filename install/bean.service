# BEAN runtime service template. Render using install/jetson_render.py.
# Runs the existing brain, NOT the physical motion output interface.
[Unit]
Description=BEAN local brain (Jetson)
After=network.target

[Service]
Type=simple
User=@BEAN_USER@
Group=@BEAN_GROUP@
WorkingDirectory=@BEAN_HOME@
EnvironmentFile=@BEAN_ENV_FILE@
ExecStart=@BEAN_HOME@/.venv/bin/python3 @BEAN_HOME@/bean_run.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

[Install]
WantedBy=multi-user.target
